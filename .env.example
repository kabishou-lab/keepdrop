# OpenAI-compatible Chat Completions. No TypeSafe key. No local weights.
# Copy to .env. MiniMax-M3 is the lab default.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M3
# Optional USD list price for the judge $ line (MiniMax-M3 standard ≤512k).
OPENAI_INPUT_USD_PER_MTOK=0.30
OPENAI_OUTPUT_USD_PER_MTOK=1.20
# Hypothetical next-prompt coder rate for the saved~ line.
OPENAI_CODER_USD_PER_MTOK=2
